<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Live location between check-in and check-out only (PRD §2.9), shown by a persistent
         notification, after an in-app disclosure. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Sideloaded, owner-approved (24 Sep 2026); re-check before any Play release. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- In-app update of the sideloaded APK (owner, 28 Sep 2026): "Install unknown apps" for NEXUS. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Not required: a phone without them installs and reads attendance, and says why it
         cannot take it (REQ-ATT-39). -->
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <application
        android:name=".NexusApplication"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nexus"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="video/mp4" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- nexus://<screen>[?…]. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="nexus" />
            </intent-filter>
            <!-- Form (/f/…) and members-only vault (/v/…) links open in the app; assetlinks.json is
                 live with the release key. Public /s/ links are never claimed (PRD §4.6). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="nexus.znetworks.id" android:pathPrefix="/f/" />
                <data android:scheme="https" android:host="nexus.znetworks.id" android:pathPrefix="/v/" />
            </intent-filter>
        </activity>
        <service android:name=".feature.meetings.MeetingRecordingService" android:exported="false" android:foregroundServiceType="microphone" />
        <service android:name="androidx.work.impl.foreground.SystemForegroundService" android:foregroundServiceType="dataSync" tools:node="merge" />

        <service
            android:name=".feature.push.NexusMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <service
            android:name=".feature.attendance.trail.WorkTrailService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <receiver
            android:name=".feature.attendance.trail.WorkTrailBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".feature.update.InstallResultReceiver"
            android:exported="false" />

        <!-- Camera shots for request evidence, and downloaded attachments handed to a viewer. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Persists the in-app language on API < 33 (Android 13+ stores it in the system). -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
        <!-- Home-screen widget (PRD Phase 5): today's attendance and the last seven days. -->
        <receiver
            android:name=".feature.widget.AttendanceWidgetReceiver"
            android:exported="true"
            android:label="@string/wg_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/attendance_widget_info" />
        </receiver>
        <!-- Calendar widgets (phase 4): Month, Month + Coming up, This Week, the four lists; each picks a scope. -->
        <activity
            android:name=".feature.calendar.widget.CalendarWidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.Nexus">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".feature.calendar.widget.CalMonthWidgetReceiver"
            android:exported="true"
            android:label="@string/wcal_month_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/cal_month_widget_info" />
        </receiver>
        <receiver
            android:name=".feature.calendar.widget.CalMonthUpcomingWidgetReceiver"
            android:exported="true"
            android:label="@string/wcal_month_up_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/cal_month_upcoming_widget_info" />
        </receiver>
        <receiver
            android:name=".feature.calendar.widget.CalWeekWidgetReceiver"
            android:exported="true"
            android:label="@string/wcal_week_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/cal_week_widget_info" />
        </receiver>
        <receiver
            android:name=".feature.calendar.widget.CalDoWidgetReceiver"
            android:exported="true"
            android:label="@string/wcal_q_do">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/cal_do_widget_info" />
        </receiver>
        <receiver
            android:name=".feature.calendar.widget.CalPlanWidgetReceiver"
            android:exported="true"
            android:label="@string/wcal_q_plan">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/cal_plan_widget_info" />
        </receiver>
        <receiver
            android:name=".feature.calendar.widget.CalActWidgetReceiver"
            android:exported="true"
            android:label="@string/wcal_q_act">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/cal_act_widget_info" />
        </receiver>
        <receiver
            android:name=".feature.calendar.widget.CalLaterWidgetReceiver"
            android:exported="true"
            android:label="@string/wcal_q_later">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/cal_later_widget_info" />
        </receiver>
    </application>
</manifest>
