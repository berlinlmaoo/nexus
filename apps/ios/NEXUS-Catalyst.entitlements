<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Mac Catalyst entitlements, kept separate from the iOS ones on purpose.
	     The com.apple.security.* keys below are macOS sandbox entitlements. On an iOS build they
	     are not merely useless: an unrecognised entitlement makes provisioning fail outright, so
	     the two platforms cannot share one file. project.yml points the macosx SDK at this one. -->

	<key>aps-environment</key>
	<string>development</string>

	<!-- Passkeys, same as the iOS file. Associated domains is NOT a macOS-sandbox key, so it is
	     valid on both platforms — but entitlements do not merge across the two files, so the
	     Catalyst build only gets it if it is written here as well. See NEXUS.entitlements for the
	     server-side half of the handshake. -->
	<!-- `applinks:` was deliberately absent here until Z Vault, and the reason it is now present
	     is that the missing half finally exists.

	     On Mac Catalyst a universal link is delivered as an NSUserActivity, and SwiftUI's
	     `.onOpenURL` — the correct handler on iOS — is never called for it. Claiming the domain
	     without a handler would take the link away from Safari and then do nothing with it, which
	     is worse than not claiming it at all. NexusApp now carries
	     `.onContinueUserActivity(NSUserActivityTypeBrowsingWeb)` alongside `.onOpenURL`; each
	     platform calls exactly one of the two. Remove that modifier and this line must go with it. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:nexus.znetworks.id</string>
		<string>applinks:nexus.znetworks.id</string>
	</array>

	<!-- Required for the Mac App Store. Everything below re-opens exactly what the sandbox closes
	     and nothing more; each line is a capability the app already uses on iOS. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>

	<!-- Outbound only. The app talks to nexus.znetworks.id and to Apple's push service; it never
	     listens for connections, so no server entitlement. -->
	<key>com.apple.security.network.client</key>
	<true/>

	<!-- Attendance verifies you are inside a registered office area. Without this the sandbox
	     denies CoreLocation and check-in fails with no visible reason. -->
	<key>com.apple.security.personal-information.location</key>
	<true/>

	<!-- The webcam, for "Take a photo" in chat, tickets, forms and GIDEON. UIImagePickerController
	     has no camera source on Mac Catalyst, so DeskCameraCapture drives an AVCaptureSession
	     directly — which the sandbox denies without this, with no visible reason. Attendance is
	     deliberately NOT part of this: a check-in still happens on the phone. -->
	<key>com.apple.security.device.camera</key>
	<true/>

	<!-- Photos chosen for a chat message or an avatar. PhotosPicker runs out of process, but the
	     file it hands back still has to be readable. -->
	<!-- UIKit's picker requests a read/write sandbox extension even for import-as-copy.
	     Access remains limited to files the person explicitly selects in the native panel. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
</dict>
</plist>
