    <!-- Sesi kerja / lokasi -->
    <string name="channel_work_session">Sesi kerja</string>
    <string name="work_session_title">Sesi kerja</string>
    <string name="work_session_inside">Di kantor · lokasi dicek sekitar sejam sekali</string>
    <string name="work_session_outside">Di luar kantor · rute direkam sekitar tiap 15 menit</string>
    <string name="trail_disclosure_title">Lokasi selama jam kerja</string>
    <string name="trail_disclosure_body">Selama jam kerja, dari absen masuk sampai absen pulang, NEXUS mengecek posisimu sekitar sejam sekali saat kamu di kantor, dan mengikuti rutemu (sekitar tiap 15 menit) saat kamu keluar, termasuk saat aplikasi ditutup atau tidak dipakai. Tidak ada yang direkam sebelum absen masuk atau setelah absen pulang. Ketidakhadiran lama dari kantor jadi terlihat dan bisa ditutup dengan izin. Atasanmu dan BoD bisa melihat jejak hari itu. Notifikasi tetap tampil selama berjalan.\n\nKalau kamu menolak, harimu tampil \"lokasi mati\" di papan.</string>
    <string name="trail_agree">Setuju dan lanjut</string>
    <string name="not_now">Jangan sekarang</string>
    <string name="trail_always_title">Tetap jalan setelah HP restart</string>
    <string name="trail_always_body">Izinkan NEXUS memakai lokasi \"sepanjang waktu\", supaya sesi kerja lanjut sendiri kalau HP restart.</string>
    <string name="trail_always_body_settings">Di layar berikutnya pilih \"Izinkan sepanjang waktu\" untuk Lokasi, supaya sesi kerja lanjut sendiri kalau HP restart. Tetap hanya dipakai antara absen masuk dan pulang.</string>
    <string name="trail_always_go">Lanjut</string>
    <string name="battery_title">Jangan biarkan NEXUS ditidurkan</string>
    <string name="battery_body">Beberapa HP menghentikan aplikasi di latar belakang demi baterai, dan sesi kerja jadi berhenti merekam. Izinkan NEXUS berjalan di latar belakang.</string>
    <string name="battery_go">Izinkan</string>
    <string name="battery_xiaomi">Xiaomi / Redmi / POCO: nyalakan Autostart, atur Penghemat baterai ke \"Tanpa batasan\", dan kunci NEXUS di aplikasi terbaru.</string>
    <string name="battery_oppo">Oppo / Realme / OnePlus: nyalakan Luncurkan otomatis (\"Izinkan aktivitas latar belakang\") dan atur baterai ke \"Jangan optimalkan\".</string>
    <string name="battery_vivo">Vivo / iQOO: izinkan konsumsi daya latar belakang tinggi dan nyalakan Autostart.</string>
    <string name="battery_samsung">Samsung: atur Baterai ke \"Tidak dibatasi\" dan keluarkan NEXUS dari \"Aplikasi tidur\".</string>
    <string name="battery_huawei">Huawei / Honor: di Peluncuran aplikasi, kelola NEXUS secara manual dan izinkan ketiga tombolnya.</string>

