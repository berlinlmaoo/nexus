# Nexus production-oriented environment example.
# Copy to .env.production for docker-compose.prod.yml:
#   cp .env.example .env.production

APP_NAME=Nexus
APP_TIMEZONE=Asia/Jakarta
APP_PORT=3000
LOG_LEVEL=info

# Apple Push Notification service (server-only App Store Connect .p8 key)
APNS_TEAM_ID=5YR5T42G97
APNS_KEY_ID=
APNS_BUNDLE_ID=id.znetworks.nexus
# Keep this quoted; Docker accepts literal \\n sequences and the server expands them.
APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----"
CRON_SECRET=

# Public canonical URL
NEXTAUTH_URL=https://nexus.patsgroup.id
NEXT_PUBLIC_APP_URL=https://nexus.patsgroup.id
AUTH_TRUST_HOST=true

# NextAuth
AUTH_SECRET=replace-with-openssl-rand-hex-64
# NEXTAUTH_SECRET is optional when AUTH_SECRET is set.

# PostgreSQL on Mac mini only
POSTGRES_USER=nexus_user
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_DB=nexus_db
DATABASE_URL=postgresql://nexus_user:replace-with-strong-db-password@postgres:5432/nexus_db?schema=public

# Local persistent data on the Mac mini
NEXUS_DATA_DIR=./var
BACKUP_DIR=./backups/postgres

# Prisma / DB connection tuning
DB_POOL_MAX=20
DB_IDLE_TIMEOUT=30000
DB_CONNECT_TIMEOUT=5000

# SMTP for OTP + transactional email
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM="NEXUS <noreply@patsgroup.id>"
SMTP_HELO_NAME=nexus.patsgroup.id

# Optional realtime horizontal scaling (not needed for single-host production)
REDIS_URL=

# GIDEON/Hermes service API
NEXUS_GIDEON_SERVICE_TOKEN=
NEXUS_GIDEON_ACTOR_EMAIL=

# Optional app integrations
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=
GOOGLE_DRIVE_API_KEY=
GOOGLE_SHEETS_API_KEY=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
WA_WEBHOOK_URL=http://host.docker.internal:3001/send
# Optional explicit Hermes WhatsApp bridge URL. Defaults to WA_WEBHOOK_URL when empty.
HERMES_WA_BRIDGE_URL=http://host.docker.internal:3001/send
SLACK_WEBHOOK_URL=
SENTRY_DSN=

# Finance dashboard gate + Google Sheets source
# Sheet columns: Month/Bulan, Revenue/Pendapatan, Expense/Beban, Target, Cashflow.
FINANCE_DASHBOARD_PASSWORD=
FINANCE_DASHBOARD_PASSWORD_HASH=
FINANCE_DASHBOARD_SHEET_ID=
FINANCE_DASHBOARD_SHEET_RANGE=PnL!A:F
FINANCE_DASHBOARD_SHEET_CSV_URL=
FINANCE_DASHBOARD_TARGET_MARGIN=25

# Optional NAS integration used by the application itself
NAS_HOST=
NAS_PORT=5000
NAS_PROTOCOL=http
NAS_ALLOWED_PATHS=/volume1
NAS_USERNAME=
NAS_PASSWORD=

# Attendance / app-specific optional flags
ATTENDANCE_SILENT_CORRECTION_ADMINS=

# Backup sync to NAS over SSH
NAS_SSH_HOST=
NAS_SSH_PORT=22
NAS_SSH_USER=
NAS_BACKUP_DIR=/volume1/backups/nexus/postgres
NAS_UPLOADS_DIR=/volume1/backups/nexus/uploads
