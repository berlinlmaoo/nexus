# ===========================================
# NEXUS — Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values.
# Required variables are marked with [REQUIRED].

# ----- Database -----
# [REQUIRED] PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/nexus_db"

# ----- Authentication -----
# [REQUIRED] NextAuth secret — generate with: openssl rand -base64 32
AUTH_SECRET="your-secret-key-here"

# [REQUIRED] Application URL
NEXTAUTH_URL="http://localhost:3000"

# Trust the host header (set to true behind a reverse proxy)
AUTH_TRUST_HOST=true

# ----- Google OAuth (SSO) -----
# [REQUIRED] Google OAuth credentials for @patsgroup.id sign-in
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your-google-client-secret"

# ----- Google Drive Integration -----
# Optional — enables Google Drive file browsing and uploads
GOOGLE_DRIVE_CLIENT_ID="your-drive-client-id.apps.googleusercontent.com"
GOOGLE_DRIVE_CLIENT_SECRET="GOCSPX-your-drive-client-secret"
GOOGLE_DRIVE_REDIRECT_URI="http://localhost:3000/api/drive/auth"
GOOGLE_DRIVE_API_KEY="your-drive-api-key"

# ----- Synology NAS (File Station) -----
# Optional — enables NAS file browsing and uploads
NAS_HOST="192.168.1.100"
NAS_PORT="5000"
NAS_PROTOCOL="http"
NAS_USERNAME="admin"
NAS_PASSWORD="your-nas-password"
NAS_ALLOWED_PATHS="/volume1"

# ----- SMTP Email (Notifications) -----
# Optional — enables email notifications
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@patsgroup.id"
SMTP_PASS="your-app-password"
SMTP_FROM="NEXUS <noreply@patsgroup.id>"

# ----- WhatsApp Webhook (Notifications) -----
# Optional — enables WhatsApp notifications
WA_WEBHOOK_URL=""

# ----- Slack Webhook (Notifications) -----
# Optional — enables Slack notifications
SLACK_WEBHOOK_URL=""
