# Nexus production-oriented environment example.
# Copy to .env.production for docker-compose.prod.yml:
#   cp .env.example .env.production

APP_NAME=Nexus
APP_TIMEZONE=Asia/Jakarta
APP_PORT=3000
LOG_LEVEL=info

# Public canonical URL
NEXTAUTH_URL=https://nexus.patsgroup.id
NEXT_PUBLIC_APP_URL=https://nexus.patsgroup.id
AUTH_TRUST_HOST=true

# NextAuth
AUTH_SECRET=replace-with-openssl-rand-hex-64
# NEXTAUTH_SECRET is optional when AUTH_SECRET is set.

# PostgreSQL on Mac mini only
POSTGRES_USER=nexus_user
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_DB=nexus_db
DATABASE_URL=postgresql://nexus_user:replace-with-strong-db-password@postgres:5432/nexus_db?schema=public

# Local persistent data on the Mac mini
NEXUS_DATA_DIR=./var
BACKUP_DIR=./backups/postgres

# Prisma / DB connection tuning
DB_POOL_MAX=20
DB_IDLE_TIMEOUT=30000
DB_CONNECT_TIMEOUT=5000

# SMTP for OTP + transactional email
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM="NEXUS <noreply@patsgroup.id>"
SMTP_HELO_NAME=nexus.patsgroup.id

# Optional realtime horizontal scaling (not needed for single-host production)
REDIS_URL=

# Optional app integrations
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=
GOOGLE_DRIVE_API_KEY=
WA_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
SENTRY_DSN=

# Optional NAS integration used by the application itself
NAS_HOST=
NAS_PORT=5000
NAS_PROTOCOL=http
NAS_ALLOWED_PATHS=/volume1
NAS_USERNAME=
NAS_PASSWORD=

# Attendance / app-specific optional flags
ATTENDANCE_SILENT_CORRECTION_ADMINS=

# Backup sync to NAS over SSH
NAS_SSH_HOST=
NAS_SSH_PORT=22
NAS_SSH_USER=
NAS_BACKUP_DIR=/volume1/backups/nexus/postgres
NAS_UPLOADS_DIR=/volume1/backups/nexus/uploads
