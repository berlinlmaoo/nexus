# Database
DATABASE_URL="postgresql://user:password@localhost:5432/apex_db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# Anthropic (for GIDEON AI)
ANTHROPIC_API_KEY="sk-ant-your-key-here"

# Synology NAS (File Station)
NAS_HOST="192.168.223.92"
NAS_PORT="5000"
NAS_PROTOCOL="http"
NAS_USERNAME="admin"
NAS_PASSWORD="your-nas-password"
NAS_ALLOWED_PATHS="/volume1"

# Google OAuth (SSO)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# SMTP Email (Notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@patsgroup.id"
SMTP_PASS="your-app-password"
SMTP_FROM="NEXUS <noreply@patsgroup.id>"

# WhatsApp Webhook (Notifications)
WA_WEBHOOK_URL=""

# Slack Webhook (Notifications)
SLACK_WEBHOOK_URL=""
