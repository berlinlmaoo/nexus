<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shared container the watch complication reads. Written by the watch app after it loads
	     today; the complication extension declares the same group. The group id is the one the
	     phone uses — an App Group is registered once per team and assigned to each App ID. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.id.znetworks.nexus</string>
	</array>
</dict>
</plist>
