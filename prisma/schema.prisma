// ===== Gamification (XP / levels / quests) =====
model UserXp {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalXp      Int      @default(0)
  currentLevel Int      @default(1)
  updatedAt    DateTime @updatedAt
}

model XpTransaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  reason    String   // task_done | priority_bonus | goal_milestone | streak | quest
  taskId    String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model UserStreak {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStreak   Int       @default(0)
  longestStreak   Int       @default(0)
  lastActivityDay DateTime?
  updatedAt       DateTime  @updatedAt
}

model Quest {
  id              String   @id @default(cuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  requirementType String   // task_count | overdue_cleared | priority_done | specific_tasks
  requiredCount   Int      @default(1)
  xpReward        Int      @default(50)
  isActive        Boolean  @default(true)
  teamIds         String[] @default([]) // assigned teams; empty = semua crew (ignored for specific_tasks)
  taskIds         String[] @default([]) // specific_tasks quest: exact tasks to finish; visible to those tasks' project members, XP to whoever completes them
  deadline        DateTime?              // jangka waktu — quest expired setelah ini
  createdById     String
  createdBy       User     @relation("QuestCreator", fields: [createdById], references: [id])
  createdAt       DateTime @default(now())
  claims          QuestClaim[]

  @@index([workspaceId, isActive])
}

model QuestClaim {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questKey  String   // admin quest id OR auto template key (e.g. "auto:weekly-10")
  periodKey String   // weekly reset bucket, e.g. "2026-W23"
  xpAwarded Int      @default(0)
  claimedAt DateTime @default(now())
  questId   String?
  quest     Quest?   @relation(fields: [questId], references: [id], onDelete: SetNull)

  @@unique([userId, questKey, periodKey])
  @@index([userId])
}

// ===== Messages (DM / group / project chat) =====
enum ConversationType {
  DM
  GROUP
  PROJECT
}

model Conversation {
  id        String           @id @default(cuid())
  type      ConversationType
  name      String?
  projectId String?          @unique
  project   Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  members  ConversationMember[]
  messages Message[]
}

model ConversationMember {
  id             String   @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt       DateTime @default(now())
  lastReadAt     DateTime?

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content        String
  createdAt      DateTime @default(now())

  @@index([conversationId, createdAt])
}

// ── P&L Dashboard (standalone per-project finance: transaction-level expenses + income pipeline) ──
// Access is BoD-and-above only (workspace role BOD/ONE_ABOVE_ALL), enforced in src/lib/pnl.ts.
// Deliberately NOT linked to tasks/FinanceValue — the user wants this view fully standalone.

/// Per-project expense category (custom, with color) — breakdowns in the dashboard follow it.
model PnlCategory {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  color     String   @default("#7b68ee")
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses  PnlExpense[]
  recurring PnlRecurringExpense[]

  @@index([projectId])
}

/// One expense transaction (per-day granularity; dashboard rolls up to week/month).
model PnlExpense {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date        DateTime
  amount      Float
  description String?
  categoryId  String?
  category    PnlCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  // Set when this entry was auto-posted from a recurring template (idempotency + provenance).
  recurringId String?
  recurring   PnlRecurringExpense? @relation(fields: [recurringId], references: [id], onDelete: SetNull)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  attachments PnlExpenseAttachment[]

  @@index([projectId, date])
  @@index([recurringId, date])
}

/// Receipt/photo attached to an expense. Files live in public/uploads/attachments (same mounted
/// dir as task attachments) and are served via the login-gated /api/files route.
model PnlExpenseAttachment {
  id         String     @id @default(cuid())
  expenseId  String
  expense    PnlExpense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  filename   String
  url        String
  mimeType   String
  size       Int
  uploaderId String?
  createdAt  DateTime   @default(now())

  @@index([expenseId])
}

/// Custom income-pipeline stage per project (e.g. Penawaran → Invoice → DP/Termin → Lunas).
model PnlIncomeStage {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  color     String   @default("#0091ff")
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  incomes PnlIncome[]

  @@index([projectId])
}

/// One income deal/invoice moving through the pipeline. Money actually received is recorded as
/// PnlIncomePayment rows (clients pay in parts: DP, termin, pelunasan) — realized revenue comes
/// from payments, NOT from totalAmount.
model PnlIncome {
  id           String    @id @default(cuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title        String
  totalAmount  Float
  stageId      String?
  stage        PnlIncomeStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  expectedDate DateTime?
  notes        String?
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  payments PnlIncomePayment[]

  @@index([projectId])
}

/// A real money-in event against a deal (DP/termin/pelunasan).
model PnlIncomePayment {
  id        String    @id @default(cuid())
  incomeId  String
  income    PnlIncome @relation(fields: [incomeId], references: [id], onDelete: Cascade)
  date      DateTime
  amount    Float
  note      String?
  createdAt DateTime  @default(now())

  @@index([incomeId, date])
}

/// Monthly expense budget target — dashboard shows on/over-budget against actual spend.
model PnlBudget {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  year      Int
  month     Int // 1..12
  amount    Float
  updatedAt DateTime @updatedAt

  @@unique([projectId, year, month])
}

/// Recurring monthly expense template (gaji, sewa, langganan). Materialized lazily into
/// PnlExpense rows by postDueRecurringPnlExpenses() whenever the dashboard loads — no cron.
model PnlRecurringExpense {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  description   String
  amount        Float
  categoryId    String?
  category      PnlCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  dayOfMonth    Int      @default(1) // posting day (clamped to month length)
  active        Boolean  @default(true)
  // Last "YYYY-MM" month key already materialized (idempotency cursor; months in between are backfilled).
  lastPostedKey String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  expenses PnlExpense[]

  @@index([projectId])
}

// ─── THE WIRE (FEED) ─────────────────────────────────────────
// Company-wide firehose timeline (Twitter/X-style). Deliberately NOT workspace-scoped:
// every authenticated user sees one global feed. Mentions/likes/comments are per-user.
// Soft-delete (deletedAt) + denormalized likeCount/commentCount synced inside the like/comment tx.

model Post {
  id           String        @id @default(cuid())
  text         String        @db.Text          // ≤280 enforced in the API
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  editedAt     DateTime?                        // shows "· edited" when set
  deletedAt    DateTime?                        // soft delete; feed filters deletedAt: null
  authorId     String
  author       User          @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  images       PostImage[]
  mentions     PostMention[]
  likes        PostLike[]
  comments     PostComment[]
  likeCount    Int           @default(0)
  commentCount Int           @default(0)

  @@index([deletedAt, createdAt])               // primary feed path: where deletedAt null order by createdAt desc
  @@index([authorId, createdAt])
}

model PostImage {
  id        String  @id @default(cuid())
  postId    String
  post      Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  url       String                              // gated /api/files/feed/<name>
  mimeType  String
  size      Int
  width     Int?                                // stored to kill CLS (reserve aspect-ratio box)
  height    Int?
  position  Int     @default(0)

  @@index([postId])
}

model PostMention {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("PostMentionUser", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])                    // one mention row per (post,user)
  @@index([userId])                             // "posts mentioning me" tab
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("PostLikeUser", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])                    // 1 like/user — DB-enforced idempotency key for the toggle
  @@index([postId])
}

model PostComment {
  id        String    @id @default(cuid())
  text      String    @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  postId    String
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation("PostCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  parentId  String?                             // reserved for v2 threads

  @@index([postId, createdAt])
}

// ─── INTEGRITY (PEER REPORTS / "cepu") ───────────────────────
// BETA: BoD-and-above only. Reports of policy violations; on VERIFY, XP can move
// (reporter +bounty, reported −penalty) — but XP is gated behind PEER_REPORT_XP_ENABLED
// (default OFF) until governance sign-off. Snapshot XP onto the row so config changes
// don't rewrite history; PeerReportEvent = append-only audit; reversible via shared reason.

enum PeerReportStatus {
  PENDING
  VERIFIED
  REJECTED
  WITHDRAWN
}

enum PeerReportCategory {
  SMOKING_INDOORS
  SMOKING_TOILET
  SAFETY_VIOLATION
  CLEANLINESS
  EQUIPMENT_MISUSE
  POLICY_OTHER
}

model PeerReport {
  id                String             @id @default(cuid())
  reporterId        String
  reporter          User               @relation("PeerReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUserId    String
  reportedUser      User               @relation("PeerReportReported", fields: [reportedUserId], references: [id], onDelete: Cascade)
  category          PeerReportCategory
  reason            String             @db.Text
  evidenceUrl       String?            // gated /api/files/peer-reports/<name>; REQUIRED at create (API-enforced)
  evidenceMimeType  String?
  evidenceSize      Int?
  status            PeerReportStatus   @default(PENDING)
  rebuttal          String?            @db.Text       // reported person's response (future; reserved)
  rebuttalAt        DateTime?
  reviewerId        String?
  reviewer          User?              @relation("PeerReportReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewNote        String?            @db.Text        // rationale, shown on the report
  reviewedAt        DateTime?
  reporterBountyXp  Int                @default(0)     // SNAPSHOT as-applied (immutable)
  reportedPenaltyXp Int                @default(0)     // stored positive, applied negative
  xpAppliedAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  events            PeerReportEvent[]

  @@index([status, createdAt])
  @@index([reportedUserId, status])
  @@index([reporterId, createdAt])
  @@index([reviewerId])
}

model PeerReportEvent {
  id         String     @id @default(cuid())
  reportId   String
  report     PeerReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  action     String     // created | verified | rejected | withdrawn | reversed
  fromStatus String?
  toStatus   String?
  note       String?    @db.Text
  actorId    String?
  createdAt  DateTime   @default(now())

  @@index([reportId, createdAt])
}

// ── Complaint & Escalation channel ───────────────────────────────────────────────
// A private, categorized chat between a staff member and the BoD for operational/HR grievances.
// Distinct from PeerReport (which is PUBLIC + punitive): complaints stay CONFIDENTIAL (BoD-only),
// support an ANONYMOUS option (reporter hidden even from BoD), and are a back-and-forth thread.
enum ComplaintCategory {
  ATTENDANCE
  EXP
  PAYROLL
  DAY_OFF
  OPERATIONAL
  HR
  LEADERSHIP
  OTHER
}

enum ComplaintStatus {
  OPEN       // baru masuk, belum ditangani
  IN_REVIEW  // lagi ditangani BoD
  RESOLVED   // selesai / ada solusi
  CLOSED     // ditutup tanpa tindak lanjut
}

model Complaint {
  id            String             @id @default(cuid())
  workspaceId   String
  workspace     Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  reporterId    String
  reporter      User               @relation("ComplaintReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  category      ComplaintCategory
  subject       String
  anonymous     Boolean            @default(false) // reporter hidden from reviewers (BoD) too
  confidential  Boolean            @default(false) // flagged extra-sensitive (badge for BoD)
  status        ComplaintStatus    @default(OPEN)
  lastMessageAt DateTime           @default(now())
  resolvedAt    DateTime?
  resolvedById  String?
  resolvedBy    User?              @relation("ComplaintResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  messages      ComplaintMessage[]
  events        ComplaintEvent[]

  @@index([reporterId, createdAt])
  @@index([status, lastMessageAt])
}

model ComplaintMessage {
  id           String    @id @default(cuid())
  complaintId  String
  complaint    Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  authorId     String
  author       User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  fromReviewer Boolean   @default(false) // true = BoD/reviewer side; false = reporter side
  body         String    @db.Text
  createdAt    DateTime  @default(now())

  @@index([complaintId, createdAt])
}

model ComplaintEvent {
  id          String    @id @default(cuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  action      String    // filed | status
  fromStatus  String?
  toStatus    String?
  actorId     String?
  createdAt   DateTime  @default(now())

  @@index([complaintId, createdAt])
}
