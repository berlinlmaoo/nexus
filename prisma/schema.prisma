// ─── PHASE 1A MODELS ─────────────────────────────────────────

model Attachment {
  id        String   @id @default(cuid())
  filename  String
  url       String
  mimeType  String
  size      Int
  createdAt DateTime @default(now())

  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  uploaderId String
  uploader   User   @relation(fields: [uploaderId], references: [id])

  annotations ProofAnnotation[]
}

model ProofAnnotation {
  id           String   @id @default(cuid())
  x            Float
  y            Float
  width        Float    @default(0)
  height       Float    @default(0)
  comment      String
  resolved     Boolean  @default(false)
  createdAt    DateTime @default(now())

  attachmentId String
  attachment   Attachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)

  userId       String
  user         User       @relation(fields: [userId], references: [id])
}

model Form {
  id          String   @id @default(cuid())
  name        String
  slug        String?  @unique
  description String?
  fields      Json
  branding    Json?    // { logoUrl, primaryColor, backgroundColor, headerImage }
  accessSchedule Json?  // { enabled, daysOfWeek, startTime, endTime, timezone }
  isPublic    Boolean  @default(false)
  // When true, submitting requires a logged-in NEXUS account (any user, not just project
  // members) — the form page is still reachable, but submission is gated + submitterId is
  // always captured so the submitter can track their request under "Pengajuan Saya".
  requireAuth Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  submissions FormSubmission[]
}

model FormSubmission {
  id        String   @id @default(cuid())
  data      Json
  createdAt DateTime @default(now())

  formId    String
  form      Form     @relation(fields: [formId], references: [id], onDelete: Cascade)

  taskId    String?  @unique
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  submitterId String?
}

// --- Finance dashboard (per Finance project, monthly OPEX + Revenue) ---
// Structure (categories + line items) is shared/fixed (seeded from the OPEX sheet); only
// the monthly amounts (FinanceValue) are per-project and entered by finance staff.
model FinanceCategory {
  id        String            @id @default(cuid())
  kind      String            // "OPEX" | "REVENUE"
  name      String
  order     Int               @default(0)
  lineItems FinanceLineItem[]
  createdAt DateTime          @default(now())

  @@index([kind, order])
}

model FinanceLineItem {
  id         String          @id @default(cuid())
  categoryId String
  category   FinanceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name       String
  order      Int             @default(0)
  values     FinanceValue[]

  @@index([categoryId, order])
}

model FinanceValue {
  id         String          @id @default(cuid())
  projectId  String
  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lineItemId String
  lineItem   FinanceLineItem @relation(fields: [lineItemId], references: [id], onDelete: Cascade)
  year       Int
  month      Int             // 1..12
  amount     Float           @default(0)
  updatedById String?
  updatedAt  DateTime        @updatedAt

  @@unique([projectId, lineItemId, year, month])
  @@index([projectId, year])
}

// --- Announcements (BoD-posted pop-ups shown once per user) ---
model Announcement {
  id          String              @id @default(cuid())
  title       String
  body        String
  tone        String              @default("info") // info | success | warning
  active      Boolean             @default(true)
  // Audience: empty = EVERYONE (default). Non-empty = only these user ids see the pop-up.
  targetUserIds String[]          @default([])
  imageUrl    String?             // optional image shown in the pop-up (e.g. violation evidence photo)
  createdById String?
  createdAt   DateTime            @default(now())
  seenBy      AnnouncementSeen[]

  @@index([active, createdAt])
}

model AnnouncementSeen {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  seenAt         DateTime     @default(now())

  @@unique([announcementId, userId])
  @@index([userId])
}

model StatusUpdate {
  id        String        @id @default(cuid())
  status    ProjectHealth @default(ON_TRACK)
  text      String
  createdAt DateTime      @default(now())

  projectId String
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  authorId  String
  author    User          @relation(fields: [authorId], references: [id])
}

model Favorite {
  id        String   @id @default(cuid())
  type      String
  targetId  String
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, targetId])
}

// ─── WAVE 2 MODELS ──────────────────────────────────────────

model TaskRelation {
  id           String @id @default(cuid())
  type         String // RELATED_TO, BLOCKS, BLOCKED_BY, DUPLICATES, PARENT_OF
  createdAt    DateTime @default(now())

  sourceTaskId String
  sourceTask   Task   @relation("TaskRelationSource", fields: [sourceTaskId], references: [id], onDelete: Cascade)

  targetTaskId String
  targetTask   Task   @relation("TaskRelationTarget", fields: [targetTaskId], references: [id], onDelete: Cascade)

  @@unique([sourceTaskId, targetTaskId, type])
}

model SyncedBlock {
  id        String   @id @default(cuid())
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NotificationPreference {
  id                String   @id @default(cuid())
  emailEnabled      Boolean  @default(true)
  waEnabled         Boolean  @default(false)
  slackEnabled      Boolean  @default(false)
  desktopEnabled    Boolean  @default(false)
  desktopSoundEnabled Boolean @default(true)
  waPhone           String?
  slackWebhook      String?
  taskAssigned      Boolean  @default(true)
  taskDueSoon       Boolean  @default(true)
  commentMention    Boolean  @default(true)
  projectInvite     Boolean  @default(true)
  statusUpdate      Boolean  @default(true)

  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── BATCH C MODELS ──────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  action     String   // "create" | "update" | "delete" | "login" | "export" | "invite"
  entityType String   // "task" | "project" | "doc" | "user" | "comment" | "webhook"
  entityId   String?
  entityName String?
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  metadata   Json?    // old values, new values, diff
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entityType])
  @@index([action])
  @@index([createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// ─── BATCH B MODELS ──────────────────────────────────────────

model Webhook {
  id        String   @id @default(cuid())
  url       String
  events    String[] // ["task.created", "task.updated", "task.completed", "comment.created", "project.updated"]
  secret    String   @default(cuid()) // for HMAC signing
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  deliveries WebhookDelivery[]
}

model WebhookDelivery {
  id         String   @id @default(cuid())
  event      String
  payload    Json
  statusCode Int?
  response   String?
  success    Boolean  @default(false)
  attempts   Int      @default(0)
  createdAt  DateTime @default(now())

  webhookId  String
  webhook    Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
}

model InviteToken {
  id        String      @id @default(cuid())
  email     String
  token     String      @unique
  role      ProjectRole @default(MEMBER)
  expiresAt DateTime
  accepted  Boolean     @default(false)
  createdAt DateTime    @default(now())

  projectId String
  inviterId String
  inviter   User        @relation(fields: [inviterId], references: [id])

  @@index([token])
  @@index([email])
}

model EmailOtpVerification {
  id                String     @id @default(cuid())
  email             String
  purpose           OtpPurpose
  codeHash          String
  name              String?
  passwordHash      String?
  attempts          Int        @default(0)
  expiresAt         DateTime
  resendAvailableAt DateTime
  consumedAt        DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  userId            String?
  user              User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([email, purpose])
  @@index([expiresAt])
  @@index([email])
}

// ─── PORTFOLIO MODELS ────────────────────────────────────────

model Portfolio {
  id          String          @id @default(cuid())
  name        String
  description String?
  status      PortfolioStatus @default(ON_TRACK)
  ownerId     String
  workspaceId String
