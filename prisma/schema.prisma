generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String            @id @default(cuid())
  name           String
  email          String            @unique
  password       String?
  avatar         String?
  phoneNumber    String?
  whatsappId       String?         @unique // verified WhatsApp identity (LID/JID) for the Gideon WA bot
  waLinkCode       String?         // short-lived code to link WhatsApp (self-service)
  waLinkExpiresAt  DateTime?
  role           SystemRole        @default(MEMBER)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  workspaceMembers WorkspaceMember[]
  projectMembers   ProjectMember[]
  taskAssignees    TaskAssignee[]
  comments         Comment[]
  activityLogs     ActivityLog[]
  tasksCreated     Task[]           @relation("TaskCreator")
  timeEntries      TimeEntry[]
  notifications    Notification[]
  teamMembers      TeamMember[]
  goalsOwned       Goal[]
  docsAuthored     Doc[]
  docsOwned        Doc[]            @relation("DocOwner")
  attachments      Attachment[]
  statusUpdates    StatusUpdate[]
  favorites        Favorite[]
  notificationPref NotificationPreference?
  auditLogs        AuditLog[]
  accounts         Account[]
  webhooks         Webhook[]
  inviteTokens     InviteToken[]
  portfolios       Portfolio[]
  commentReactions CommentReaction[]
  taskFollowing    TaskFollower[]
  taskLikes        TaskLike[]
  savedSearches    SavedSearch[]
  dndUntil         DateTime?
  onboardedAt      DateTime?
  sessions         UserSession[]
  workflowBundles    WorkflowBundle[]
  proofAnnotations   ProofAnnotation[]
  teamCalendarEvents TeamCalendarEvent[]         @relation("TeamCalendarEventCreator")
  roomBookings       RoomBooking[]               @relation("RoomBookingCreator")
  teamCalendarEventAttendances TeamCalendarEventAttendee[]
  emailOtps          EmailOtpVerification[]
  attendanceRecords  AttendanceRecord[]
  attendanceCorrections AttendanceRecord[] @relation("AttendanceRecordCorrectedBy")
  attendanceRequests AttendanceRequest[] @relation("AttendanceRequestUser")
  reviewedAttendanceRequests AttendanceRequest[] @relation("AttendanceRequestReviewedBy")
  userXp               UserXp?
  xpTransactions       XpTransaction[]
  userStreak           UserStreak?
  questsCreated        Quest[]             @relation("QuestCreator")
  questClaims          QuestClaim[]
  conversationMembers  ConversationMember[]
  messages             Message[]
  projectPins          ProjectPin[]
  folderPins           FolderPin[]
  periodRewards        PeriodReward[]
  apiTokens            ApiToken[]
  oauthAuthCodes       OAuthAuthCode[]
  postsAuthored        Post[]              @relation("PostAuthor")
  postMentions         PostMention[]       @relation("PostMentionUser")
  postLikes            PostLike[]          @relation("PostLikeUser")
  postComments         PostComment[]       @relation("PostCommentAuthor")
  peerReportsFiled     PeerReport[]        @relation("PeerReportReporter")
  peerReportsAgainst   PeerReport[]        @relation("PeerReportReported")
  peerReportsReviewed  PeerReport[]        @relation("PeerReportReviewer")
  complaintsFiled      Complaint[]         @relation("ComplaintReporter")
  complaintsResolved   Complaint[]         @relation("ComplaintResolver")
  complaintMessages    ComplaintMessage[]
}

// Per-user API token for the MCP connector (and other integrations). Only the SHA-256 hash is
// stored; the plaintext "nxs_..." (PAT) token is shown once at creation. The token acts AS the user,
// so all existing RBAC applies. Scope is enforced by which MCP tools are registered (task-only).
// OAuth-issued access tokens ("nxo_...") are also stored here with clientId set + a refresh token,
// so the same hash lookup verifies both PATs and OAuth tokens.
model ApiToken {
  id               String    @id @default(cuid())
  name             String
  tokenHash        String    @unique
  scopes           String[]  @default([])
  lastUsedAt       DateTime?
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())

  // OAuth-issued tokens only (null for personal access tokens minted in Tuning Room).
  clientId             String?
  refreshTokenHash     String?   @unique
  // Previous (rotated-away) refresh hash — presenting it again = token theft → revoke the connection.
  prevRefreshTokenHash String?   @unique
  refreshExpiresAt     DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  client OAuthClient? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([clientId])
}

// A client app registered via OAuth 2.1 Dynamic Client Registration (RFC 7591) — e.g. the Claude
// app connecting as a custom connector. Public clients (PKCE), no client secret.
model OAuthClient {
  id                      String   @id @default(cuid())
  clientName              String
  redirectUris            String[] @default([])
  grantTypes              String[] @default([])
  responseTypes           String[] @default([])
  tokenEndpointAuthMethod String   @default("none")
  scopes                  String[] @default([])
  createdAt               DateTime @default(now())

  authCodes OAuthAuthCode[]
  tokens    ApiToken[]
}

// Short-lived OAuth 2.1 authorization code (auth-code + PKCE flow). Single-use, ~5 min TTL.
// Only the SHA-256 hash of the code is stored.
model OAuthAuthCode {
  id                  String    @id @default(cuid())
  codeHash            String    @unique
  redirectUri         String
  codeChallenge       String
  codeChallengeMethod String    @default("S256")
  scopes              String[]  @default([])
  resource            String?
  expiresAt           DateTime
  consumedAt          DateTime?
  createdAt           DateTime  @default(now())

  clientId String
  client   OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId   String
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([userId])
}

/// Monthly XP-tier outcome per user (Excellent / Good / Review) + perk earned.
model PeriodReward {
  id          String   @id @default(cuid())
  periodKey   String   // attendance month, e.g. "2026-06"
  tier        String   // EXCELLENT | GOOD | REVIEW | NONE
  perk        String?  // human-readable reward label
  bonusDayOff Int      @default(0) // extra day-off tokens granted (usable next period)
  zeroAlpha   Boolean  @default(false)
  finalScore  Int      @default(0)
  createdAt   DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodKey])
  @@index([periodKey])
}

model Workspace {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  members         WorkspaceMember[]
  projects        Project[]
  projectFolders  ProjectFolder[]
  goals           Goal[]
  teams           Team[]
  portfolios      Portfolio[]
  docTemplates    DocTemplate[]
  ssoConfig       SsoConfig?
  workflowBundles WorkflowBundle[]
  teamCalendarEvents TeamCalendarEvent[]
  roomBookings       RoomBooking[]
  officeLocations    OfficeLocation[]
  attendanceRecords  AttendanceRecord[]
  attendanceRequests AttendanceRequest[]
  customFieldLibraries CustomFieldLibrary[]
  quests               Quest[]
  divisions            Division[]
  holidays             Holiday[]
  redDateQuotas        RedDateQuota[]
  complaints           Complaint[]
}

// Monthly "tanggal merah" quota (jatah), set by BoD per month, same for every staff. Staff
// request RED_DATE leave up to this quota for the month. One row per (workspace, month).
model RedDateQuota {
  id          String   @id @default(cuid())
  month       String // "YYYY-MM"
  quota       Int      @default(0)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  updatedById String?
  updatedAt   DateTime  @updatedAt
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, month])
}

// Company-wide public holidays ("tanggal merah"). On these dates nobody is penalized for not
// checking in, and they do NOT consume day-off quota. Input monthly by BoD. One row per date.
model Holiday {
  id          String   @id @default(cuid())
  date        DateTime // UTC-midnight of the holiday date (same convention as attendance dates)
  name        String
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdById String?
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, date])
  @@index([workspaceId, date])
}

model WorkspaceMember {
  id             String           @id @default(cuid())
  role           WorkspaceRole    @default(STAFF)
  attendanceRole AttendanceRole   @default(NONE)
  joinedAt       DateTime         @default(now())

  // Per-person attendance shift override (HH:mm). When BOTH are set, this beats the
  // team/office shift for this member (effectiveShiftSource = "USER"). Null = inherit.
  attendanceShiftStartTime String?
  attendanceShiftEndTime   String?

  // Per-weekday shift overrides, keyed by ISO weekday 1=Mon..7=Sun, e.g.
  // { "5": { "start": "15:00", "end": "00:00" } }. A weekday present here beats the default
  // shift above for that day only; absent days fall back to the default. Null/empty = none.
  attendanceShiftByDay Json?

  // Per-person monthly day-off quota override. Null = workspace default (4).
  dayOffQuota Int?

  // Flexi Time — when true, this member checks in any time in the flexi window (12:00–15:00) with no
  // late penalty, and their expected end = check-in + 9h (overrides any fixed/team/office shift).
  // Opt-in per person; default off = normal fixed shift.
  flexiTimeEnabled Boolean @default(false)

  // Custom/Mobile attendance — when true, this member may check in/out ANYWHERE (geofence radius is not
  // enforced and a checkout outside the office is NOT routed through offsite-approval). For high-mobility
  // roles. Opt-in per person; default off = normal geofenced attendance.
  noGeofenceMode Boolean @default(false)

  userId      String
  workspaceId String

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  color       String   @default("#7B2FBE")
  icon        String   @default("folder")
  enableTaskBatchDuplicate Boolean @default(false)
  autoAssignEnabled Boolean @default(false)
  autoAssignAssigneeIds String[] @default([])
  // Standalone per-project P&L dashboard (transaction-level expenses + income pipeline, BoD-only).
  // Toggled from the Tune drawer; unrelated to the legacy FinanceValue monthly matrix.
  enablePnlDashboard Boolean @default(false)
  status      ProjectStatus @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  folderId String?
  folder   ProjectFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  members        ProjectMember[]
  taskLists      TaskList[]
  activityLogs   ActivityLog[]
  sprints        Sprint[]
  automations    Automation[]
  customFields   CustomField[]
  customFieldLibraries CustomFieldLibrary[]
  docs           Doc[]
  forms          Form[]
  financeValues  FinanceValue[]
  statusUpdates  StatusUpdate[]
  pages          ProjectPage[]
  webhooks           Webhook[]
  goalProjects       GoalProject[]
  portfolioProjects  PortfolioProject[]
  teamProjects       TeamProject[]
  taskProjects       TaskProject[]
  conversation       Conversation?
  pins               ProjectPin[]
  pnlCategories      PnlCategory[]
  pnlExpenses        PnlExpense[]
  pnlIncomeStages    PnlIncomeStage[]
  pnlIncomes         PnlIncome[]
  pnlBudgets         PnlBudget[]
  pnlRecurring       PnlRecurringExpense[]
}

/// Per-user pinned project (sidebar quick-access). One row = one user pinning one project.
model ProjectPin {
  id        String   @id @default(cuid())
  position  Int      @default(0)
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([userId])
}

/// Per-user pinned FOLDER (sidebar quick-access). Mirrors ProjectPin exactly.
model FolderPin {
  id        String   @id @default(cuid())
  position  Int      @default(0)
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  folderId  String
  folder    ProjectFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@unique([userId, folderId])
  @@index([userId])
}

model ProjectMember {
  id        String      @id @default(cuid())
  role      ProjectRole @default(MEMBER)
  source    String      @default("direct")  // "direct" | "team:{teamId}"
  joinedAt  DateTime    @default(now())

  userId    String
  projectId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
}

model ProjectFolder {
  id        String   @id @default(cuid())
  name      String
  icon      String   @default("📁")
  color     String   @default("#111827")
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Self-referential tree (nested folders, max depth enforced in the app). Deleting a parent detaches
  // its children to root (SetNull); the DELETE handler reparents them to the removed folder's parent.
  parentFolderId String?
  parent         ProjectFolder?  @relation("FolderTree", fields: [parentFolderId], references: [id], onDelete: SetNull)
  children       ProjectFolder[] @relation("FolderTree")

  projects Project[]
  pins     FolderPin[]

  // Folder aggregate view (board + calendar): a CURATED set of project ids to pull tasks from.
  // Empty = fall back to every project currently in the folder (and its subtree), resolved in the app.
  aggregateProjectIds String[] @default([])

  @@unique([workspaceId, name])
  @@index([workspaceId, position])
  @@index([parentFolderId])
}

model TaskList {
  id        String   @id @default(cuid())
  name      String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  tasks        Task[]
  taskProjects TaskProject[]
}

model Task {
  id             String       @id @default(cuid())
  title          String
  description    String?
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  position       Int          @default(0)
  dueDate        DateTime?
  tags           String[]     @default([])
  estimatedHours Float?
  actualHours    Float?
  taskType       TaskType     @default(TASK)
  startDate      DateTime?
  isRecurring    Boolean      @default(false)
  recurPattern   Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  taskListId  String
  taskList    TaskList @relation(fields: [taskListId], references: [id], onDelete: Cascade)

  creatorId   String
  creator     User     @relation("TaskCreator", fields: [creatorId], references: [id])

  parentId    String?
  parent      Task?    @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks    Task[]   @relation("Subtasks")

  assignees         TaskAssignee[]
  comments          Comment[]
  activityLogs      ActivityLog[]
  timeEntries       TimeEntry[]
  customFieldValues CustomFieldValue[]
  sprintTasks       SprintTask[]
  dependencies      TaskDependency[] @relation("TaskDependencies")
  dependedOnBy      TaskDependency[] @relation("TaskDependedOnBy")
  notifications     Notification[]
  attachments       Attachment[]
  formSubmission    FormSubmission?
  relationsFrom     TaskRelation[]   @relation("TaskRelationSource")
  relationsTo       TaskRelation[]   @relation("TaskRelationTarget")
  goalTasks         GoalTask[]
  followers         TaskFollower[]
  likes             TaskLike[]
  taskProjects      TaskProject[]

  @@index([parentId])
  @@index([taskListId])
  @@index([creatorId])
  @@index([status])
  @@index([dueDate])
  @@index([priority])
}

model TaskAssignee {
  id         String   @id @default(cuid())
  assignedAt DateTime @default(now())

  taskId String
  userId String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isEdited  Boolean  @default(false)

  taskId String
  userId String

  parentId String?
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  reactions CommentReaction[]

  @@index([taskId])
}

model CommentReaction {
  id        String   @id @default(cuid())
  emoji     String
  createdAt DateTime @default(now())

  commentId String
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId, emoji])
}

model TaskFollower {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  taskId    String
  task      Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([userId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  action    String
  details   String?
  createdAt DateTime @default(now())

  userId    String
  taskId    String?
  projectId String?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  task    Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([projectId])
}

// ─── NEW MODELS ────────────────────────────────────────────────

model Goal {
  id          String     @id @default(cuid())
  title       String
  description String?
  status      GoalStatus @default(ON_TRACK)
  progress    Int        @default(0)
  dueDate     DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  parentId    String?
  parent      Goal?    @relation("SubGoals", fields: [parentId], references: [id], onDelete: SetNull)
  children    Goal[]   @relation("SubGoals")

  milestones GoalMilestone[]
  goalProjects GoalProject[]
  goalTasks    GoalTask[]
}

model GoalMilestone {
  id        String    @id @default(cuid())
  title     String
  completed Boolean   @default(false)
  dueDate   DateTime?

  goalId String
  goal   Goal   @relation(fields: [goalId], references: [id], onDelete: Cascade)
}

model GoalProject {
  id        String  @id @default(cuid())
  goalId    String
  projectId String
  goal      Goal    @relation(fields: [goalId], references: [id], onDelete: Cascade)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@unique([goalId, projectId])
}

model GoalTask {
  id     String @id @default(cuid())
  goalId String
  taskId String
  goal   Goal   @relation(fields: [goalId], references: [id], onDelete: Cascade)
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  @@unique([goalId, taskId])
}

model Doc {
  id          String   @id @default(cuid())
  title       String
  content     Json?
  contentText String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Wiki fields
  parentId           String?
  parent             Doc?     @relation("DocChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children           Doc[]    @relation("DocChildren")
  position           Int      @default(0)
  icon               String?
  coverImage         String?
  verifiedAt         DateTime?
  verificationStatus String?  @default("NEEDS_REVIEW")

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  ownerId  String?
  owner    User?  @relation("DocOwner", fields: [ownerId], references: [id], onDelete: SetNull)
}

model TimeEntry {
  id          String    @id @default(cuid())
  startTime   DateTime
  endTime     DateTime?
  duration    Int?
  description String?

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Sprint {
  id        String       @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  status    SprintStatus @default(PLANNING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  tasks SprintTask[]
}

model SprintTask {
  id String @id @default(cuid())

  sprintId String
  sprint   Sprint @relation(fields: [sprintId], references: [id], onDelete: Cascade)

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([sprintId, taskId])
}

model Automation {
  id        String  @id @default(cuid())
  name      String
  trigger   Json
  action    Json
  condition Json?
  enabled   Boolean @default(true)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model CustomField {
  id      String          @id @default(cuid())
  name    String
  type    CustomFieldType @default(TEXT)
  options Json?
  position Int            @default(0)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  libraryId String?
  library   CustomFieldLibrary? @relation(fields: [libraryId], references: [id], onDelete: SetNull)

  values CustomFieldValue[]

  @@index([libraryId])
}

model CustomFieldLibrary {
  id        String          @id @default(cuid())
  name      String
  type      CustomFieldType @default(TEXT)
  options   Json?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  sourceProjectId String?
  sourceProject   Project? @relation(fields: [sourceProjectId], references: [id], onDelete: SetNull)

  fields CustomField[]

  @@index([workspaceId])
  @@index([sourceProjectId])
}

model CustomFieldValue {
  id    String @id @default(cuid())
  value String

  customFieldId String
  customField   CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([customFieldId, taskId])
}

model TaskDependency {
  id   String         @id @default(cuid())
  type DependencyType @default(BLOCKING)

  taskId        String
  task          Task   @relation("TaskDependencies", fields: [taskId], references: [id], onDelete: Cascade)

  dependsOnTaskId String
  dependsOnTask   Task   @relation("TaskDependedOnBy", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnTaskId])
}

model Notification {
  id        String   @id @default(cuid())
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  taskId    String?
  task      Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  projectId String?

  @@index([userId])
}

model Team {
  id                             String  @id @default(cuid())
  name                           String
  color                          String  @default("#7B2FBE")
  attendanceShiftOverrideEnabled Boolean @default(false)
  attendanceShiftStartTime       String?
  attendanceShiftEndTime         String?

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  divisionId String?
  division   Division? @relation(fields: [divisionId], references: [id], onDelete: SetNull)

  members  TeamMember[]
  projects TeamProject[]
  calendarEvents TeamCalendarEvent[]
  attendanceRequests AttendanceRequest[]
}

/// Grouping layer above teams (divisi / perusahaan). Teams optionally belong to one.
model Division {
  id          String   @id @default(cuid())
  name        String
  color       String   @default("#64748B")
  position    Int      @default(0)
  createdAt   DateTime @default(now())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  teams Team[]

  @@unique([workspaceId, name])
}

model TeamCalendarEvent {
  id          String                  @id @default(cuid())
  title       String
  description String?
  location    String?
  startsAt    DateTime?
  endsAt      DateTime?
  isAllDay    Boolean                 @default(false)
  status      TeamCalendarEventStatus @default(ACTIVE)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  teamId      String
  team        Team                    @relation(fields: [teamId], references: [id], onDelete: Cascade)

  workspaceId String
  workspace   Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User                    @relation("TeamCalendarEventCreator", fields: [createdById], references: [id], onDelete: Cascade)

  attendees   TeamCalendarEventAttendee[]

  @@index([teamId, startsAt])
  @@index([workspaceId, startsAt])
  @@index([status])
}

model RoomBooking {
  id          String            @id @default(cuid())
  room        String
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime
  status      RoomBookingStatus @default(ACTIVE)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  workspaceId String
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User              @relation("RoomBookingCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([workspaceId, startsAt])
  @@index([room, startsAt])
  @@index([status])
}

model TeamCalendarEventAttendee {
  id        String            @id @default(cuid())
  createdAt DateTime          @default(now())

  eventId   String
  event     TeamCalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
}

model TeamProject {
  id        String  @id @default(cuid())
  teamId    String
  projectId String
  team      Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@unique([teamId, projectId])
}

model OfficeLocation {
  id                     String   @id @default(cuid())
  name                   String
  address                String?
  latitude               Float
  longitude              Float
  radiusMeters           Int
  timezone               String   @default("Asia/Jakarta")
  workdays               Int[]    @default([1, 2, 3, 4, 5, 6, 7])
  shiftStartTime         String   @default("09:00")
  shiftEndTime           String   @default("18:00")
  lateGraceMinutes       Int      @default(15)
  earlyLeaveGraceMinutes Int      @default(0)
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  attendanceRecords AttendanceRecord[]

  @@index([workspaceId, isActive])
}

model AttendanceRecord {
  id                    String           @id @default(cuid())
  attendanceDate        DateTime
  checkInAt             DateTime?
  checkOutAt            DateTime?
  effectiveShiftSource  AttendanceShiftSource @default(OFFICE)
  effectiveTeamId       String?
  effectiveTeamName     String?
  effectiveShiftStartTime String?
  effectiveShiftEndTime String?
  checkInStatus         AttendanceCheckInStatus?
  checkOutStatus        AttendanceCheckOutStatus?
  lateMinutes           Int              @default(0)
  earlyLeaveMinutes     Int              @default(0)
  workedMinutes         Int              @default(0)
  checkInLat            Float?
  checkInLng            Float?
  checkOutLat           Float?
  checkOutLng           Float?
  checkInAddress        String?
  checkOutAddress       String?
  checkInPhotoUrl       String?
  checkOutPhotoUrl      String?
  checkInDistanceMeters Float?
  checkOutDistanceMeters Float?
  // Offsite checkout: staff checked out beyond the office geofence (e.g. meeting/shoot). Requires a
  // reason and BoD approval. checkOutApproval is null for normal on-site checkouts, otherwise one of
  // PENDING | APPROVED | REJECTED.
  checkOutOffsite       Boolean          @default(false)
  checkOutApproval      String?
  checkOutReason        String?
  checkOutApprovedById  String?
  checkOutApprovedAt    DateTime?
  // Daily Reflection — mandatory ≥200-char recap captured at check-out (work done today, progress,
  // blockers, next priorities). Stored separately from `notes` for auditability/reporting.
  checkOutReflection    String?
  checkOutReflectionAt  DateTime?
  // Flexi Time — whether this record was computed under flexi rules (check-in window 12:00–15:00,
  // expected end = check-in + 9h). Stored so re-derivation/audit doesn't fall back to fixed-shift math.
  attendanceFlexi       Boolean          @default(false)
  notes                 String?
  status                AttendanceStatus @default(CHECKED_IN)
  correctedAt           DateTime?
  correctionReason      String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  correctedById   String?
  correctedBy     User?          @relation("AttendanceRecordCorrectedBy", fields: [correctedById], references: [id], onDelete: SetNull)
  workspaceId     String
  workspace       Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  officeLocationId String
  officeLocation  OfficeLocation @relation(fields: [officeLocationId], references: [id], onDelete: Restrict)

  @@unique([userId, workspaceId, attendanceDate])
  @@index([workspaceId, attendanceDate])
  @@index([officeLocationId, attendanceDate])
  @@index([status, attendanceDate])
}

model AttendanceRequest {
  id                    String                    @id @default(cuid())
  startDate             DateTime
  endDate               DateTime
  type                  AttendanceRequestType
  status                AttendanceRequestStatus   @default(PENDING)
  reason                String
  reviewNote            String?
  approvalSource        AttendanceApprovalSource?
  supportingDocumentUrl String?
  supportingDocumentName String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  reviewedAt            DateTime?

  userId                String
  user                  User                      @relation("AttendanceRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  reviewedById          String?
  reviewedBy            User?                     @relation("AttendanceRequestReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  workspaceId           String
  workspace             Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  teamId                String?
  team                  Team?                     @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status, startDate])
  @@index([userId, startDate])
  @@index([teamId, status])
}

model TeamMember {
  id                           String   @id @default(cuid())
  role                         TeamRole @default(MEMBER)
  isAttendancePrimary          Boolean  @default(false)
  attendancePrimaryWorkspaceId String?

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@unique([userId, attendancePrimaryWorkspaceId])
}

enum TeamRole {
  LEAD
  MEMBER
}

enum RoomBookingStatus {
  ACTIVE
  CANCELLED
}

enum TeamCalendarEventStatus {
  ACTIVE
  CANCELLED
}

model ProjectPage {
  id          String   @id @default(cuid())
  name        String
  icon        String   @default("📄")
  pageType    String   @default("custom")
  content     Json?
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  parentId    String?
  parent      ProjectPage? @relation("SubPages", fields: [parentId], references: [id], onDelete: Cascade)
  children    ProjectPage[] @relation("SubPages")
}

