# GIDEON Hermes session retention, DEV profile (owner, 19 Oct 2026). Deletes GIDEON sessions idle > 90 days
# from ~/.hermes/profiles/gideon-dev/state.db (a profile only GIDEON uses, hence --scope profile), then
# compacts (FTS merge + VACUUM) when anything was deleted, including by the shim's per-meeting forget.
# Install: sudo install -m 0644 gideon-dev-forget.{service,timer} /etc/systemd/system/ && sudo systemctl daemon-reload && sudo systemctl enable --now gideon-dev-forget.timer
[Unit]
Description=GIDEON DEV Hermes session retention (90 days)

[Service]
Type=oneshot
User=debian
Environment=HOME=/home/debian
Environment=HERMES_HOME=/home/debian/.hermes/profiles/gideon-dev
ExecStart=/home/debian/.hermes/hermes-agent/.venv/bin/python /home/debian/gideon-dev/gideon-forget.py retention --days 90 --scope profile
Nice=10
IOSchedulingClass=idle
