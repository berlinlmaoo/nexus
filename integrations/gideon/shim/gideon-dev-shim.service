# DEV ONLY (12 Oct 2026): GIDEON for the NEXUS dev server. Separate from gideon-shim.service (prod, :8765).
#  - port 8766, LAN address; the firewall rules below admit ONLY nexus-prod (192.168.223.111), where the
#    dev app reaches it through the nexus-dev-gideon-relay container.
#  - Hermes profile gideon-dev: its .env aims the NEXUS plugin at https://nexus-prod.tail765d02.ts.net:8443
#    (the dev server) with a dev-only token; its plugin copy registers no attendance tools; toolsets are
#    nexus + vision only; memory off; no gateway (no Telegram / WhatsApp / api_server).
# Off switch: sudo systemctl disable --now gideon-dev-shim
[Unit]
Description=GIDEON DEV shim (NEXUS dev server only, profile gideon-dev, :8766)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=debian
WorkingDirectory=/home/debian/gideon-dev
Environment=HOME=/home/debian
Environment=PATH=/home/debian/.local/bin:/home/debian/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
Environment=HERMES_BIN=/home/debian/.local/bin/hermes
Environment=CODEX_BIN=/home/debian/.npm-global/bin/codex
Environment=ORACLE_LLM_HOST=192.168.223.116
Environment=ORACLE_LLM_PORT=8766
Environment=HERMES_PROFILE_HOME=/home/debian/.hermes/profiles/gideon-dev
Environment=GIDEON_RUNNER=/home/debian/gideon-dev/gideon-stream-runner.py
Environment=GIDEON_PYTHON=/home/debian/.hermes/hermes-agent/.venv/bin/python
Environment=GIDEON_TOOLSETS=nexus,vision
Environment=GIDEON_DOCS=0
Environment=GIDEON_SHIM_NAME=gideon-dev
Environment=NEXUS_GIDEON_NO_ATTENDANCE=1
EnvironmentFile=/home/debian/gideon-dev/shim.env
# Only nexus-prod may connect (idempotent; root via the + prefix).
ExecStartPre=+/bin/sh -c '/usr/sbin/iptables -C INPUT -p tcp --dport 8766 -s 192.168.223.111 -j ACCEPT 2>/dev/null || /usr/sbin/iptables -I INPUT -p tcp --dport 8766 -s 192.168.223.111 -j ACCEPT; /usr/sbin/iptables -C INPUT -p tcp --dport 8766 -j DROP 2>/dev/null || /usr/sbin/iptables -A INPUT -p tcp --dport 8766 -j DROP'
ExecStart=/usr/bin/node /home/debian/gideon-dev/codex-oracle-shim.js
Restart=always
RestartSec=5
MemoryMax=3G

[Install]
WantedBy=multi-user.target
