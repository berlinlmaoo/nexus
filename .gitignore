# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
.env
.env.production
.env.production.*
.env.docker
.env.docker.nas

# local runtime data
/var/
# sibling runtime-data dirs: beta/staging Postgres volumes + uploads, prod DB backups (var-beta/, var-prod-backups/, var-staging/, …)
/var-*/
# runtime user uploads (avatars, project-icons, attachments, …) — written to Docker-mounted volumes at
# runtime, NOT source. The Dockerfile mkdir -p's these dirs on build, so they don't need to be tracked.
/public/uploads/
/backups/
*.sql
*.sql.gz
*.sqlite
*.sqlite3
postgres-data/

# vendored third-party project (carries its own .git, ~566M) — never commit into this repo
/AFFiNE/

# Kredensial dan rahasia yang tinggal di dalam pohon repo. Ditulis di sini karena
# `git add -A` pernah mencoba meng-commit cloudflared/creds-znet.json dan hanya
# tertahan oleh permission file — bukan pengaman yang layak diandalkan dua kali.
cloudflared/
cron/cron-secret.txt
.env.runtime
*.bak-*

# Keluaran build dan sampah runtime. dist-new adalah folder kerja skrip deploy SPA
# (build ke sana dulu, baru ditimpakan ke dist) — bukan sesuatu yang perlu dilacak,
# dan 79 berkas hash baru setiap kali akan menenggelamkan setiap diff.
apps/web/dist-new/
cron/cron.log
__pycache__/
deploy/bluegreen/RUNBOOK.md
apps/android/docs/HANDOFF-ANDROID.md

# Private operations material: runbooks, host scripts, agent notes and old machine configs. They live in
# the private ops folder on the deploy host, never in this public repo. Listed so a local copy is not
# committed by accident.
.claude/
CLAUDE.md
**/CLAUDE.md
/AGENTS.md
/reports/
deploy/dev/
deploy/macos/
deploy/cloudflared/
deploy/bluegreen/prod-patches/
deploy/bluegreen/deploy-nexus-bluegreen.sh
deploy/bluegreen/prod-migrate.sh
deploy/bluegreen/vps-harness.sh
deploy/bluegreen/vps-kuma-standby-monitor.py
integrations/gideon/shim/*.service
maintenance/*.bak*
maintenance/*.mac-asli
apps/ios/CARA-KERJA.md
/README-production.md
/PLAN-*.md
docs/plans/
*.apk
*.aab
*.ipa
# Onboarding screenshots were captured from real data; real copies are kept privately and dropped in at deploy.
apps/web/public/onboarding/*.png

# Internal company documents (PRD & rules) - kept locally, never pushed (public repo)
/docs/internal/
