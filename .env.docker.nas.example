# Copy this file to .env.docker.nas before running:
# docker compose --env-file .env.docker.nas -f docker-compose.nas.yml up -d --build

APP_PORT=3000
DATABASE_URL=postgresql://username:password@192.168.223.92:5433/nexus_db?schema=public&sslmode=disable

AUTH_SECRET=replace-with-openssl-rand-hex-32
NEXTAUTH_URL=https://nexus.patsgroup.id
AUTH_TRUST_HOST=true
CLOUDFLARED_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token

# Google Workspace SMTP relay (recommended for OTP email)
SMTP_HOST=smtp-relay.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=NEXUS <noreply@your-domain.com>
