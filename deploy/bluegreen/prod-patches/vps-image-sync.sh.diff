--- a/vps-image-sync.sh
+++ b/vps-image-sync.sh
@@ -5,6 +5,9 @@
 set -u
 exec 9>/tmp/vps-image-sync.lock; flock -n 9 || exit 0
 LOG=$HOME/vps-sync.log
+# Blue-green: releases reach the VPS at switch time; this nightly run is only the safety net (idempotent:
+# "standby already runs …" when nothing differs).
+exec $HOME/deploy-nexus-bluegreen.sh vps-follow >> "$LOG" 2>&1
 id=$(docker image inspect nexus-app:prod --format '{{.Id}}')
 remote=$(ssh vps 'docker image inspect nexus-app:prod --format "{{.Id}}" 2>/dev/null')
 if [ "$id" = "$remote" ]; then echo "$(date '+%F %T') image sama, lewati" >> "$LOG"; exit 0; fi
