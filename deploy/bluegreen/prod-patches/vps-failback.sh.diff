--- a/failback.sh
+++ b/failback.sh
@@ -3,7 +3,9 @@
 # (Failback sesudah bencana sungguhan beda: kantor harus di-seed dari VPS dulu — lihat RUNBOOK.md.)
 set -euo pipefail
 echo "1/4 connector VPS mati"
-cd /srv/nexus-app && docker compose --profile failover down >/dev/null 2>&1 || docker rm -f nexus-znet-cloudflared >/dev/null 2>&1 || true
+# Only the connector. (`compose --profile failover down` used to remove nexus-app-beta + nexus-web too, and step 3's
+# `compose restart` never brought them back: the standby was left without an app — found in the 12 Oct 2026 harness.)
+cd /srv/nexus-app && docker compose --profile failover rm -sf cloudflared >/dev/null 2>&1 || docker rm -f nexus-znet-cloudflared >/dev/null 2>&1 || true
 echo "2/4 replika di-seed ulang dari kantor"
 cd /srv/nexus-standby && docker compose down >/dev/null 2>&1
 docker volume rm nexus-standby-pgdata >/dev/null
@@ -15,5 +17,13 @@
 for i in $(seq 1 30); do [ "$(docker exec nexus-standby psql -U nexus_user -d nexus_db -tAc 'select pg_is_in_recovery()' 2>/dev/null)" = "t" ] && break; sleep 2; done
 docker exec nexus-standby psql -U nexus_user -d nexus_db -tAc "select 'replika lagi, lag='||coalesce((now()-pg_last_xact_replay_timestamp())::text,'-')"
 echo "3/4 app cadangan dihubungkan lagi ke replika"
-cd /srv/nexus-app && docker compose restart nexus-app-beta >/dev/null
+# Blue-green (deploy/bluegreen/RUNBOOK.md part C): after the migration the app is the live slot; start-live restarts it
+# and recreates it (and nexus-web) when the re-seeded standby's network is new. Before it: compose nexus-app-beta.
+if [ -s /srv/nexus-app/bluegreen/live ]; then
+  docker restart "nexus-app-$(cat /srv/nexus-app/bluegreen/live)" >/dev/null 2>&1 || true
+  /srv/nexus-app/bluegreen/bin/vps-bluegreen.sh start-live >/dev/null
+else
+  # recreate: the re-seed rebuilt nexus-standby_default, so a plain restart would keep a dead network endpoint
+  cd /srv/nexus-app && docker compose up -d --force-recreate nexus-app-beta nexus-web >/dev/null
+fi
 echo "4/4 nexus.znetworks.id → HTTP $(curl -s -o /dev/null -m 8 -w '%{http_code}' https://nexus.znetworks.id/api/health) (harus dari kantor sekarang)"
