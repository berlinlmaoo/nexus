+# Blue-green: the VPS nginx conf is GENERATED like the office one (nginx-gen.py --profile vps: no LAN 443 block), then
+# tested inside the VPS nexus-web before it replaces the live file.
+python3 $HOME/nexus-data/bluegreen/bin/nginx-gen.py --profile vps maintenance/phaethon.conf /tmp/vps-default.conf --raw-port 3002 --preview-port 3012 >/dev/null \
