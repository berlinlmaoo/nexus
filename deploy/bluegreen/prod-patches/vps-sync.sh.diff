+# Blue-green: the SPA travels with each release (deploy-nexus-bluegreen.sh -> vps-bluegreen.sh follow). Here only
+# the retry: while a release has not reached the standby (marker vps-skew), try again every 5 minutes.
+r3=0; [ -e $HOME/nexus-data/bluegreen/vps-skew ] && { $HOME/deploy-nexus-bluegreen.sh vps-follow >> $HOME/nexus-data/bluegreen/vps-follow.log 2>&1; r3=$?; }
