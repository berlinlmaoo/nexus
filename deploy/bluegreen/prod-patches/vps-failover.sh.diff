--- a/failover.sh
+++ b/failover.sh
@@ -19,8 +19,15 @@
 docker exec nexus-standby psql -U nexus_user -d nexus_db -tAc "select 'primary, users='||count(*) from \"User\""
 echo "2/4 app boleh menulis file"
 sudo chown -R 1001:1001 /srv/nexus-app/uploads
-cd /srv/nexus-app && docker compose restart nexus-app-beta >/dev/null
-for i in $(seq 1 30); do docker exec nexus-web wget -qO- -T 3 http://nexus-app-beta:3000/api/health 2>/dev/null | grep -q '"database":"up"' && break; sleep 2; done
+# Blue-green (deploy/bluegreen/RUNBOOK.md part C): the app is the LIVE slot named in /srv/nexus-app/bluegreen/live
+# (nexus-app-blue / nexus-app-green); before that migration it is the compose container nexus-app-beta.
+APP=nexus-app-beta
+LIVE=$(cat /srv/nexus-app/bluegreen/live 2>/dev/null || true)
+case "$LIVE" in blue|green) APP="nexus-app-$LIVE" ;; esac
+echo "   app: $APP"
+cd /srv/nexus-app && docker restart "$APP" >/dev/null
+# Through nexus-web (what cloudflared reaches), so the check covers nginx -> app -> database in either shape.
+for i in $(seq 1 30); do docker exec nexus-web wget -qO- -T 3 http://127.0.0.1:3000/api/health 2>/dev/null | grep -q '"database":"up"' && break; sleep 2; done
 echo "3/4 connector tunnel naik"
 # The tunnel is locally managed: without its ingress file the connector answers 503 to everything (2 Oct 2026).
 [ -s /srv/nexus-app/cloudflared/config.yml ] || { echo "GAGAL: /srv/nexus-app/cloudflared/config.yml tidak ada (aturan rute tunnel)"; exit 3; }
